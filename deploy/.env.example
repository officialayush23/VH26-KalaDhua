# Copy to deploy/.env and edit. Never commit the filled-in version.
# Secrets live in backend/.env, which compose reads separately.

# --- engine ---------------------------------------------------------------
RUST_LOG=info
AURA_CAPACITY_BYTES=536870912         # 512 MB logical pool
AURA_HOST_BUDGET_BYTES=2147483648     # what the controller believes it may grow into
AURA_MEM_LIMIT=2g                     # hard container ceiling. Keep well above the pool:
                                      # metadata and fragmentation measured about 1.5x
AURA_PREDICTOR=gbdt                   # heuristic | linear | gbdt

# --- dashboard ------------------------------------------------------------
# The engine as the BROWSER sees it, not as compose sees it. On Railway this is the
# engine service's public URL.
PUBLIC_AURA_URL=http://localhost:8080

# --- load generator (profile: load) ---------------------------------------
SIM_USERS=40000                        # population, not a request rate
SIM_RPS=300
SIM_DURATION=600

LOG_LEVEL=INFO
