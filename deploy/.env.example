# Copy to deploy/.env and edit. Never commit the filled-in version.
# Secrets live in backend/.env, which compose reads separately.

# --- engine ---------------------------------------------------------------
RUST_LOG=info
AURA_CAPACITY_BYTES=536870912         # 512 MB logical pool
AURA_HOST_BUDGET_BYTES=2147483648     # what the controller believes it may grow into
AURA_MEM_LIMIT=2g                     # hard container ceiling. Keep well above the pool:
                                      # metadata and fragmentation measured about 1.5x
AURA_PREDICTOR=gbdt                   # heuristic | linear | gbdt

# --- dashboard ------------------------------------------------------------
# The engine as the BROWSER sees it, not as compose sees it. On Railway this is the
# engine service's public URL.
PUBLIC_AURA_URL=http://localhost:8080

# --- load generator (profile: load) ---------------------------------------
SIM_USERS=40000                        # population, not a request rate
SIM_RPS=300
SIM_DURATION=600

LOG_LEVEL=INFO

# --- authentication --------------------------------------------------------
# open      every route answers without a credential. Local demos only.
# enforced  applications carry a key, people sign in. Required for a public address.
AURA_AUTH=open

# The first console account, created on first boot and persisted to aura_users.
# AURA_ROOT_EMAIL=you@example.com
# AURA_ROOT_PASSWORD=at-least-ten-characters

# Optional: sign sessions with your own secret instead of one derived from the root
# password hash. Without it, changing the root password ends every session, which is
# usually what you want.
# AURA_SESSION_SECRET=

# --- console ---------------------------------------------------------------
# The console's only variable, baked into the bundle at build time.
# VITE_AURA_URL=https://your-engine.onrender.com

# --- hosted deployment only -----------------------------------------------
# Railway and Render set PORT themselves and route to nothing else. The engine and the
# applications read it; do not set it by hand locally.
#
# Supabase gives two DSNs. Set both and the analytics app tries direct first, then the
# pooler. Render containers have no IPv6 route, so only the pooler works there.
#   SUPABASE_DIRECT_CONNECTION_URL=postgresql://...@db.<ref>.supabase.co:5432/postgres
#   SUPABASE_TRANSACTION_URL=postgresql://...@aws-0-<region>.pooler.supabase.com:6543/postgres
