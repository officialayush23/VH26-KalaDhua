# ---------------------------------------------------------------------------
# Paste into Render → aura-engine → Environment. Every line is required unless
# marked optional. Replace the angle-bracket values.
# ---------------------------------------------------------------------------

# Anything with a public address runs enforced. The engine refuses to start in this mode
# with no way for anyone to sign in, rather than quietly accepting everyone.
AURA_AUTH=enforced

# The first account. Created on first boot and written to aura_users, so a recycled
# container does not lose the only way in. Apply training/sql/008_users.sql first.
AURA_ROOT_EMAIL=<your email>
AURA_ROOT_PASSWORD=<at least 10 characters>

# Control plane: model bundles in, benchmark runs and audit out, accounts and keys stored.
# Never on the request path.
SUPABASE_URL=<https://xxxx.supabase.co>
SUPABASE_SERVICE_ROLE_SECRET_KEY=<service role key>

# 64 MB of payload on a 512 MB instance. --real-values holds real bytes and the measured
# overhead is about 1.5x, so this is roughly 100 MB resident before the engine's own
# structures. The host-memory clamp lowers it further if the instance has less free; it
# never raises it.
AURA__CACHE__CAPACITY_BYTES=67108864
AURA__CAPACITY__HOST_BUDGET_BYTES=134217728
AURA__CAPACITY__AUTO=true

# Use the trained bundles, pulled from Supabase Storage on boot.
AURA__PREDICTOR__KIND=gbdt
AURA__PREDICTOR__SUPABASE_AUTOLOAD=true

RUST_LOG=info

# --- optional ---------------------------------------------------------------
# Sign sessions with a secret of your own instead of one derived from the root password
# hash. Set it if you want sessions to survive a root password change.
# AURA_SESSION_SECRET=<32+ random characters>

# --- no longer used ---------------------------------------------------------
# SUPABASE_JWT_KEY   the engine issues and verifies its own sessions now
# AURA_ADMIN_TOKEN   replaced by real accounts
