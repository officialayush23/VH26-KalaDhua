# One image for all three applications and the simulator. They share a client, a cost
# meter and a settings module, and differ only in entrypoint — three images would triple
# the build time and the surface area to keep in sync for no benefit.
FROM python:3.11-slim-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

RUN useradd --system --create-home --uid 10002 aura
WORKDIR /app

COPY apps/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY apps/ ./
RUN mkdir -p /app/runs && chown -R aura:aura /app

USER aura
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# Overridden per service in the compose file.
CMD ["python", "-m", "driver.run_universe"]
