# Build the dashboard, then serve the static output. Nothing from the build stage ships:
# a React dev server in production is a common and avoidable mistake.
FROM node:20-slim AS build
WORKDIR /build
COPY frontend/universe/package*.json ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund
COPY frontend/universe/ ./
# Baked in at build time, because Vite substitutes it into the bundle.
ARG VITE_AURA_URL=http://localhost:8080
ENV VITE_AURA_URL=$VITE_AURA_URL
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /build/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s CMD wget -qO- http://localhost/ >/dev/null || exit 1
