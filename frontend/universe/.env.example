# The console's entire configuration.
#
# Copy to .env.local for local development, or paste into Vercel → Settings →
# Environment Variables. Vite substitutes this at BUILD time, so changing it means a
# redeploy, not a restart.

# The engine as the BROWSER sees it. The live socket URL is derived by swapping the
# scheme, so an https engine gives wss and there is no mixed-content block.
VITE_AURA_URL=https://vh26-kaladhua.onrender.com

# For local work against a local engine:
# VITE_AURA_URL=http://localhost:8080
